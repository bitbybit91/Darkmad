[Unit]
Description=DarkMad Hidden Services Scanner
After=network.target tor.service
Wants=tor.service

[Service]
Type=oneshot
User=darkmad
Group=darkmad
WorkingDirectory=/opt/darkmad
ExecStart=/usr/bin/python3 /opt/darkmad/darkmad_hidden.py --scan --config /opt/darkmad/config.json
StandardOutput=append:/var/log/darkmad/darkmad.log
StandardError=append:/var/log/darkmad/darkmad_error.log

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/darkmad/reports /var/log/darkmad /opt/darkmad
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
